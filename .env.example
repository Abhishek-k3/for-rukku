# Environment Variables Example
# Copy this file to .env.local and update values

# Vault PIN (DDMM format - e.g., 1202 for December 12)
VITE_VAULT_PIN=1202

# Optional: Custom audio file path
# VITE_AUDIO_PATH=/your-song.mp3

# Optional: Analytics tracking
# VITE_ANALYTICS_ID=

# Optional: Feature flags
# VITE_ENABLE_MUSIC_PLAYER=true
# VITE_ENABLE_VAULT=true
